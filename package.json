{
  "name": "tichu6",
  "version": "0.8.39",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "npm run test:unit && npm run test:ui",
    "check": "npm run release:check && npm run lint && npm run typecheck",
    "test:server": "node scripts/check-lounge.mjs",
    "dev:server": "wrangler dev --port 8787",
    "deploy:server": "wrangler deploy",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "vue-tsc --noEmit && npm run typecheck:server",
    "test:unit": "node --test tests/*.test.js",
    "test:ui": "vitest run",
    "assets:cards": "node scripts/build-card-assets.mjs",
    "test:idle": "node scripts/check-idle.mjs",
    "release:check": "node scripts/check-release-notes.mjs",
    "prebuild": "npm run release:check",
    "predeploy:server": "npm run release:check && npm run typecheck:server",
    "typecheck:server": "npm run types:server && tsc -p tsconfig.server.json",
    "types:server": "wrangler types",
    "test:flow": "node scripts/check-flow.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tensorflow/tfjs": "4.22.0",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/test-utils": "^2.6.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "vue-tsc": "^3.3.14",
    "wrangler": "^4.166.0",
    "ws": "^8.23.0"
  },
  "dependencies": {
    "hono": "4.13.21",
    "i18next": "^27.2.4",
    "i18next-browser-languagedetector": "^8.3.1",
    "i18next-vue": "^5.4.0",
    "pinia": "^4.1.0",
    "vue": "^3.5.46",
    "vue-draggable-plus": "0.6.1"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "overrides": {
    "js-beautify": {
      "glob": "^14.0.6",
      "editorconfig": "^4.0.1"
    }
  }
}
